{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(cd *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run worker:check)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm run dev:lan)",
      "Bash(node scripts/*)",
      "Bash(node --env-file=* scripts/*)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run worker:check)",
      "PowerShell(npm run dev)",
      "PowerShell(npm run dev *)",
      "PowerShell(node scripts/*)",
      "PowerShell(node --env-file=* scripts/*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git worktree *)",
      "PowerShell(git branch*)",
      "PowerShell(git switch *)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(npm run worker:deploy*)",
      "Bash(npm run worker:secret*)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall*)",
      "Bash(rm *)",
      "PowerShell(git push*)",
      "PowerShell(npm run worker:deploy*)",
      "PowerShell(npm run worker:secret*)",
      "PowerShell(wrangler *)",
      "PowerShell(npx wrangler *)",
      "PowerShell(npm install*)",
      "PowerShell(npm i *)",
      "PowerShell(npm ci*)",
      "PowerShell(Remove-Item *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(.dev.vars*)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)"
    ]
  }
}
