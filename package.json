{
  "name": "nutrition-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Registro de comidas por voz con catálogo propio (PWA + Cloudflare Worker + Gemini)",
  "scripts": {
    "test": "node --test",
    "dev": "node --env-file=.env scripts/dev-server.mjs",
    "dev:lan": "node --env-file=.env scripts/dev-server.mjs --lan",
    "token": "node scripts/new-token.mjs",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:secret:gemini": "wrangler secret put GEMINI_API_KEY --config worker/wrangler.toml",
    "worker:secret:usda": "wrangler secret put USDA_API_KEY --config worker/wrangler.toml",
    "worker:secret:token": "wrangler secret put APP_TOKEN --config worker/wrangler.toml",
    "worker:logs": "wrangler tail --config worker/wrangler.toml",
    "build:templates": "node scripts/build-templates.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.3",
    "wrangler": "^4.151.1"
  }
}
